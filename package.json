{
  "name": "water-sort-puzzle",
  "version": "0.1.0",
  "description": "Water Sort Puzzle \u2014 TypeScript + PixiJS, packaged for stores with Capacitor",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/pwa.mjs",
    "preview": "vite preview",
    "levels": "tsx scripts/gen-levels.ts",
    "test": "tsx scripts/test-core.ts",
    "build:single": "node scripts/build-single.mjs",
    "test:e2e": "node scripts/build-single.mjs --local && node scripts/e2e.mjs",
    "cap:sync": "npm run build && cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "private": true,
  "type": "module"
}
